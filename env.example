# Entorno: "development" para local, "production" para el despliegue real.
ENTORNO=development

# Clave maestra para cifrar la base de datos SQLite (SQLCipher).
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# GUÁRDALA EN UN GESTOR DE SECRETOS EN PRODUCCIÓN. Si la pierdes, pierdes los datos.
DB_ENCRYPTION_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Contraseña de administrador para crear cuentas y operaciones masivas.
ADMIN_PASSWORD=cambia-esto-por-otra-clave-larga-y-aleatoria
ADMIN_USERNAME=yo

# Hosts permitidos en producción (separados por coma).
# Ej: midominio.com,www.midominio.com
HOSTS_PERMITIDOS=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...